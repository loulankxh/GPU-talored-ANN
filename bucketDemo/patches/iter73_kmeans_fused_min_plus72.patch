+// 结果对每行 atomicMin (非负 float 的位序 = 数值序)，out 须先置 +inf。
+constexpr int kFmBM = 128, kFmBN = 64, kFmLD = 136;   // LD: 128 + 8 half, 避 bank 冲突
+constexpr size_t kFmSmem = (static_cast<size_t>(kFmBM + kFmBN) * kFmLD) * sizeof(__half)
