diff --git a/bucketDemo/buildBucket/src/bucket.cu b/bucketDemo/buildBucket/src/bucket.cu
index 25d691f..facfce7 100644
--- a/bucketDemo/buildBucket/src/bucket.cu
+++ b/bucketDemo/buildBucket/src/bucket.cu
@@ -6470,12 +6470,25 @@ static ReorderInfo compute_bucket_reorder(
     ReorderInfo r;
     r.bucket_offsets.assign(n_buckets + 1, 0);
 
-    // Count per bucket (indexed by raw bucket id, same as `assignments`).
-    std::vector<int64_t> counts(n_buckets, 0);
-    for (int64_t i = 0; i < N; ++i) {
-        int64_t b = assignments[i];
-        if (b >= 0 && b < n_buckets) counts[b]++;
+    // 并行、结果跟原来的串行版本逐位相同 (原来两遍串行扫 N 个点 + 每点一次 unordered_map 查找:
+    // SIFT100M reorder_info ~8 s): 每个线程管一段连续的 old_id，先各自按桶计数，再按 (桶, 线程号)
+    // 排出每个线程在每个桶里的起始位置——同一个桶里线程 t 的点排在线程 t-1 之后，跟串行按 old_id
+    // 递增填的顺序一样。centroid 用字节标记，只有标记过的点才查表。
+    const int T = std::max(1, omp_get_max_threads());
+    std::vector<uint32_t> tcount(static_cast<size_t>(T) * n_buckets, 0);   // [t][b]
+    #pragma omp parallel num_threads(T)
+    {
+        const int t = omp_get_thread_num();
+        const int64_t lo = N * t / T, hi = N * (t + 1) / T;
+        uint32_t* c = tcount.data() + static_cast<size_t>(t) * n_buckets;
+        for (int64_t i = lo; i < hi; ++i) {
+            int64_t b = assignments[i];
+            if (b >= 0 && b < n_buckets) c[b]++;
+        }
     }
+    std::vector<int64_t> counts(n_buckets, 0);
+    for (int t = 0; t < T; ++t)
+        for (int64_t b = 0; b < n_buckets; ++b) counts[b] += tcount[static_cast<size_t>(t) * n_buckets + b];
 
     // Lay ranges out in bucket_order sequence (position pos -> raw bucket
     // bucket_order[pos]), not raw bucket id order.
@@ -6492,22 +6505,42 @@ static ReorderInfo compute_bucket_reorder(
     r.inverse_perm.assign(r.total_in_buckets, 0);
     r.centroid_new_ids.assign(centroid_global_indices.size(), 0xFFFFFFFFu);
 
-    // old_id -> index into centroid_global_indices；只有 n_centroids 个条目，
-    // 不是 N 个——这就是不再需要全量 perm[] 数组的关键。
+    // old_id -> index into centroid_global_indices；只有 n_centroids 个条目
     std::unordered_map<int64_t, size_t> centroid_old_id_to_k;
     centroid_old_id_to_k.reserve(centroid_global_indices.size() * 2);
-    for (size_t k = 0; k < centroid_global_indices.size(); ++k)
-        centroid_old_id_to_k[centroid_global_indices[k]] = k;
-
-    std::vector<uint32_t> cursor = new_id_range_start;
-    for (int64_t old_id = 0; old_id < N; ++old_id) {
-        int64_t b = assignments[old_id];
-        if (b >= 0 && b < n_buckets) {
-            uint32_t new_id = cursor[b]++;
-            r.inverse_perm[new_id] = static_cast<uint32_t>(old_id);
-            auto it = centroid_old_id_to_k.find(old_id);
-            if (it != centroid_old_id_to_k.end())
-                r.centroid_new_ids[it->second] = new_id;
+    std::vector<char> is_cent(static_cast<size_t>(N), 0);
+    for (size_t k = 0; k < centroid_global_indices.size(); ++k) {
+        const int64_t g = centroid_global_indices[k];
+        centroid_old_id_to_k[g] = k;
+        if (g >= 0 && g < N) is_cent[static_cast<size_t>(g)] = 1;
+    }
+
+    // 每个线程在每个桶里的起始游标: start[b] + sum_{t' < t} tcount[t'][b]
+    for (int64_t b = 0; b < n_buckets; ++b) {
+        uint32_t run = new_id_range_start[b];
+        for (int t = 0; t < T; ++t) {
+            uint32_t& c = tcount[static_cast<size_t>(t) * n_buckets + b];
+            const uint32_t n = c;
+            c = run;
+            run += n;
+        }
+    }
+    #pragma omp parallel num_threads(T)
+    {
+        const int t = omp_get_thread_num();
+        const int64_t lo = N * t / T, hi = N * (t + 1) / T;
+        uint32_t* cursor = tcount.data() + static_cast<size_t>(t) * n_buckets;
+        for (int64_t old_id = lo; old_id < hi; ++old_id) {
+            int64_t b = assignments[old_id];
+            if (b >= 0 && b < n_buckets) {
+                uint32_t new_id = cursor[b]++;
+                r.inverse_perm[new_id] = static_cast<uint32_t>(old_id);
+                if (is_cent[static_cast<size_t>(old_id)]) {
+                    auto it = centroid_old_id_to_k.find(old_id);
+                    if (it != centroid_old_id_to_k.end())
+                        r.centroid_new_ids[it->second] = new_id;   // 每个 k 只被一个点写
+                }
+            }
         }
     }
     return r;
