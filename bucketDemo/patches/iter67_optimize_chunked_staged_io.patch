+// ---- 大块 I/O 小工具 (跟 prune_windowed_gpu.cu 的 Staging 同一做法) ----
+// 多线程 pread 一段文件进 dst (page cache 里的文件单线程 ifstream 读只有 ~1 GB/s)
+static void parallel_pread_file(const std::string& path, off_t off, size_t bytes, void* dst)
+{
+    int fd = ::open(path.c_str(), O_RDONLY);
+    if (fd < 0) throw std::runtime_error("parallel_pread_file: cannot open " + path);
+    constexpr size_t kPiece = size_t(16) << 20;
+    const int64_t pieces = static_cast<int64_t>((bytes + kPiece - 1) / kPiece);
+    int bad = 0;
+    #pragma omp parallel for num_threads(8) schedule(dynamic) reduction(+:bad)
+    for (int64_t i = 0; i < pieces; ++i) {
+        size_t o = static_cast<size_t>(i) * kPiece, n = std::min(kPiece, bytes - o);
+        char* p = static_cast<char*>(dst) + o;
+        while (n > 0) {
+            ssize_t r = ::pread(fd, p, n, off + static_cast<off_t>(o));
+            if (r <= 0) { ++bad; break; }
+            p += r; o += static_cast<size_t>(r); n -= static_cast<size_t>(r);
+        }
+    }
+    ::close(fd);
+    if (bad) throw std::runtime_error("parallel_pread_file: short read on " + path);
+}
