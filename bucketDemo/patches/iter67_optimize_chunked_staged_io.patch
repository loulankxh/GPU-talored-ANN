+// 两块 64 MB pinned 暂存区双缓冲的 H2D / 按行块 D2H (DMA 跟 host 拷贝 / sink 重叠)，
+// 免掉整块 cudaMallocHost (1.28 GB 要 0.7 s) 或 pageable 整块拷贝
+struct PinnedStaging {
+    static constexpr size_t kChunk = size_t(64) << 20;
+    void* pin[2] = {nullptr, nullptr};
+    cudaEvent_t ev[2] = {nullptr, nullptr};
+    bool used[2] = {false, false};
+    cudaStream_t st = nullptr;
+    PinnedStaging() {
+        CUDA_CHECK(cudaStreamCreateWithFlags(&st, cudaStreamNonBlocking));
+        for (int b = 0; b < 2; ++b) {
+            CUDA_CHECK(cudaMallocHost(&pin[b], kChunk));
+            CUDA_CHECK(cudaEventCreateWithFlags(&ev[b], cudaEventDisableTiming));
+        }
+    }
+    ~PinnedStaging() {
+        for (int b = 0; b < 2; ++b) { cudaFreeHost(pin[b]); cudaEventDestroy(ev[b]); }
+        cudaStreamDestroy(st);
+    }
+    PinnedStaging(const PinnedStaging&) = delete;
+    PinnedStaging& operator=(const PinnedStaging&) = delete;
+    void h2d(void* d, const void* h, size_t bytes) {
+        for (size_t off = 0, k = 0; off < bytes; off += kChunk, ++k) {
+            const int b = static_cast<int>(k & 1);
+            const size_t n = std::min(kChunk, bytes - off);
+            if (used[b]) CUDA_CHECK(cudaEventSynchronize(ev[b]));
+            const int64_t pieces = static_cast<int64_t>((n + (size_t(1) << 20) - 1) >> 20);
+            #pragma omp parallel for schedule(static)
+            for (int64_t i = 0; i < pieces; ++i) {
+                const size_t o = static_cast<size_t>(i) << 20;
+                std::memcpy(static_cast<char*>(pin[b]) + o, static_cast<const char*>(h) + off + o,
+                            std::min(size_t(1) << 20, n - o));
+            }
+            CUDA_CHECK(cudaMemcpyAsync(static_cast<char*>(d) + off, pin[b], n, cudaMemcpyHostToDevice, st));
+            CUDA_CHECK(cudaEventRecord(ev[b], st));
+            used[b] = true;
+        }
+        CUDA_CHECK(cudaStreamSynchronize(st));
+    }
+    template <typename Sink>
+    void d2h_rows(const uint32_t* d, int64_t N, int w, Sink&& sink) {
+        const int64_t rows_per = std::max<int64_t>(1, static_cast<int64_t>(kChunk / (static_cast<size_t>(w) * 4)));
+        auto issue = [&](int64_t r0, int b) {
+            const int64_t n = std::min(rows_per, N - r0);
+            CUDA_CHECK(cudaMemcpyAsync(pin[b], d + r0 * w, static_cast<size_t>(n) * w * 4, cudaMemcpyDeviceToHost, st));
+            CUDA_CHECK(cudaEventRecord(ev[b], st));
+        };
+        if (N > 0) issue(0, 0);
+        for (int64_t r0 = 0, k = 0; r0 < N; r0 += rows_per, ++k) {
+            const int b = static_cast<int>(k & 1);
+            if (r0 + rows_per < N) issue(r0 + rows_per, b ^ 1);
+            CUDA_CHECK(cudaEventSynchronize(ev[b]));
+            sink(static_cast<const uint32_t*>(pin[b]), r0, std::min(rows_per, N - r0));
+        }
+    }
+};
