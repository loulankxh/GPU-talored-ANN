+// float32 Step 6 (#38, 用户优先级 1): fp16 Tensor Core GEMM 给整个 pool 打分，block top-M 留每行前 R 个
+// (pool 内下标)，这里对这 R 个用 fp32 精确重算 ‖p‖² - 2·q·p (逐维顺序累加) 再取前 M。
+// 一个 warp 一行；同距离按 pool 下标小的在前。输出格式跟 block top-M 的 bucket 模式一样:
+// 第 q 行 (bucket 内行号) 的 ids = ids_pool[j]，dists = 真实 L2² (+ ‖q‖²)。
+constexpr int kRerankMaxR = 256;
+__global__ void __launch_bounds__(128) f16_rerank_topM_kernel(
+    const float* __restrict__ pool,        // (pool_size, D) fp32
+    const float* __restrict__ norms_pool,  // (pool_size,)
+    const int32_t* __restrict__ ids_pool,  // (pool_size,) gid
+    const int32_t* __restrict__ cand,      // 第 q 行 R 个 pool 下标 (-1 = 空)，行宽 R
+    int R, int D, int M, int row0, int rows,
+    int32_t* __restrict__ out_ids, float* __restrict__ out_dists)   // 行宽 M
+{
+    constexpr int LANES = 32, WPB = 4;
+    __shared__ float s_d[WPB][kRerankMaxR];
+    __shared__ int32_t s_j[WPB][kRerankMaxR];
+    const int warp = threadIdx.x / LANES, lane = threadIdx.x & (LANES - 1);
+    const int lr = blockIdx.x * WPB + warp;
+    if (lr >= rows) return;
+    const int q = row0 + lr;
+    const float* qv = pool + static_cast<int64_t>(q) * D;
+    // 一个 warp 一起算一个候选的点积: lane 取第 lane, lane+32, … 维 (合并读)，固定顺序的 xor 归约
+    constexpr int kMaxDPerLane = 8;   // D ≤ 256
+    float qr[kMaxDPerLane];
+    #pragma unroll
+    for (int u = 0; u < kMaxDPerLane; ++u) { const int e = lane + u * LANES; qr[u] = e < D ? qv[e] : 0.0f; }
+    for (int c = 0; c < R; ++c) {
+        const int32_t j = cand[static_cast<int64_t>(q) * R + c];   // warp 内一致
+        float d = INFINITY;
+        if (j >= 0) {
+            const float* pv = pool + static_cast<int64_t>(j) * D;
+            float part = 0.0f;
+            #pragma unroll
+            for (int u = 0; u < kMaxDPerLane; ++u) { const int e = lane + u * LANES; if (e < D) part += qr[u] * pv[e]; }
+            #pragma unroll
+            for (int off = 16; off > 0; off >>= 1) part += __shfl_xor_sync(0xffffffffu, part, off);
+            d = norms_pool[j] - 2.0f * part;
+        }
+        if (lane == 0) { s_d[warp][c] = d; s_j[warp][c] = j >= 0 ? j : INT_MAX; }
+    }
+    for (int k = lane; k < M; k += LANES) {   // 候选不足 M 个时剩下的位置
+        out_ids[static_cast<int64_t>(q) * M + k] = -1;
+        out_dists[static_cast<int64_t>(q) * M + k] = INFINITY;
+    }
+    __syncwarp();
+    const float qn = norms_pool[q];
+    for (int c = lane; c < R; c += LANES) {
+        const float d = s_d[warp][c];
+        const int32_t j = s_j[warp][c];
+        if (j == INT_MAX) continue;
+        int rank = 0;
+        for (int o = 0; o < R; ++o) {
+            const float od = s_d[warp][o];
+            rank += (od < d) || (od == d && s_j[warp][o] < j);
+        }
+        if (rank < M) {
+            out_ids[static_cast<int64_t>(q) * M + rank] = ids_pool[j];
+            out_dists[static_cast<int64_t>(q) * M + rank] = d + qn;
+        }
+    }
+}
