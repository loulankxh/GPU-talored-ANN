+// ---- A1-L (用户批准的 A1，大路径): 窗口内 local join，prune 之前精修中心点自己的候选行 ----
+// 点 a 的候选 = a 的前 S 个邻居 u 各自的前 S 个邻居 v (2 跳)，只取窗口里已装入的 (u、v 都在窗口)；
+// 算精确距离，比 a 的窗口内原候选里最远的还近才参与；窗口内部分按距离取前 m_in 个 (m_in = 原窗口内
+// 候选数，不变)，窗口外的原候选原样接在后面 (prune 本来就把它们当 +inf 排最后)。结果写到 own
+// (按 a - row0 行)，prune_kernel 只对 a 自己的行用它，别的点的行 (detour 计数) 仍是原表。
+struct A1LCounters { unsigned long long points, cand, pass, inserted, dbg[6]; };
+constexpr int kA1LMaxS = 16;
+template <typename T>
+__global__ void __launch_bounds__(kWarpsPerBlock * 32) a1l_window_join_kernel(
+    const int32_t* __restrict__ cand, const T* __restrict__ vec, const uint32_t* __restrict__ offsets,
+    const int32_t* __restrict__ win, const int32_t* __restrict__ win_len, const int64_t* __restrict__ cbase,
+    int64_t row0, int64_t n_rows, int M, int D, int n_buckets, int W, int S,
+    int32_t* __restrict__ own, A1LCounters* __restrict__ ctr)
+{
+    constexpr int kC = kA1LMaxS * kA1LMaxS;
+    __shared__ float   s_od[kWarpsPerBlock][kMaxM];
+    __shared__ int32_t s_oid[kWarpsPerBlock][kMaxM];
+    __shared__ float   s_cd[kWarpsPerBlock][kC];
+    __shared__ int32_t s_cid[kWarpsPerBlock][kC];
+    __shared__ int s_n[kWarpsPerBlock];
+    const int w = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int64_t a = row0 + static_cast<int64_t>(blockIdx.x) * kWarpsPerBlock + w;
+    if (a >= row0 + n_rows) return;
+    const uint32_t total = offsets[n_buckets];
+    const int p = find_pos(offsets, n_buckets, static_cast<uint32_t>(a));
+    const int32_t* wp = win + static_cast<int64_t>(p) * W;
+    const int wl = win_len[p];
+    auto row_of = [&](int q, uint32_t id) { return cbase[q] + (static_cast<int64_t>(id) - offsets[q]); };
+    // 窗口里已装入的点 → 行号，否则 -1
+    auto loaded_row = [&](int32_t id) -> int64_t {
+        if (id < 0 || static_cast<uint32_t>(id) >= total) return -1;
+        const int q = find_pos(offsets, n_buckets, static_cast<uint32_t>(id));
+        if (!in_window(wp, wl, q) || cbase[q] < 0) return -1;
+        return row_of(q, static_cast<uint32_t>(id));
+    };
+    int32_t* orow = own + (a - row0) * M;
+    if (cbase[p] < 0) {   // center not loaded (prune_kernel reports the error)
+        for (int k = lane; k < M; k += 32) orow[k] = -1;
+        return;
+    }
+    const int64_t arow = row_of(p, static_cast<uint32_t>(a));
+    const T* va = vec + arow * D;
+    auto dist_to = [&](int64_t r) {   // 一个 lane 算一整个距离 (跟 prune_kernel 同样的逐维顺序)
+        const T* vc = vec + r * D;
+        float acc = 0.f;
+        for (int d = 0; d < D; ++d) { float df = static_cast<float>(va[d]) - static_cast<float>(vc[d]); acc += df * df; }
+        return acc;
+    };
+    // 原候选: 窗口内的算距离，窗口外的 +inf
+    float kth = -INFINITY;
+    int m_in = 0;
+    for (int k = lane; k < kMaxM; k += 32) {
+        float d = INFINITY; int32_t id = -1;
+        if (k < M) {
+            id = cand[arow * M + k];
+            const int64_t r = loaded_row(id);
+            if (r >= 0) d = dist_to(r);
+        }
+        s_od[w][k] = d; s_oid[w][k] = id;
+        if (d < INFINITY) { kth = fmaxf(kth, d); ++m_in; }
+    }
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        kth = fmaxf(kth, __shfl_xor_sync(0xffffffffu, kth, off));
+        m_in += __shfl_xor_sync(0xffffffffu, m_in, off);
+    }
+    if (lane == 0) s_n[w] = 0;
+    __syncwarp();
+    // 2 跳候选 (前 S 个窗口内邻居 u 的前 S 个邻居)
+    const int nc = S * S;
+    for (int c = lane; c < nc; c += 32) {
+        const int32_t u = s_oid[w][c / S];
+        const int64_t ur = (s_od[w][c / S] < INFINITY) ? loaded_row(u) : -1;
+        if (ur < 0) continue;
+        atomicAdd(&ctr->dbg[0], 1ull);
+        const int32_t v = cand[ur * M + (c % S)];
+        if (v < 0 || v == static_cast<int32_t>(a)) continue;
+        atomicAdd(&ctr->dbg[1], 1ull);
+        bool dup = false;
+        for (int k = 0; k < M && !dup; ++k) dup = (s_oid[w][k] == v);
+        if (dup) continue;
+        atomicAdd(&ctr->dbg[2], 1ull);
+        const int64_t vr = loaded_row(v);
+        if (vr < 0) continue;
+        atomicAdd(&ctr->dbg[3], 1ull);
+        const float d = dist_to(vr);
+        if (!(d < kth)) continue;
+        atomicAdd(&ctr->dbg[4], 1ull);
+        const int slot = atomicAdd(&s_n[w], 1);
+        if (slot < kC) { s_cid[w][slot] = v; s_cd[w][slot] = d; }
+    }
+    __syncwarp();
+    const int np = min(s_n[w], kC);
+    for (int i = lane; i < np; i += 32) {   // 候选之间去重 (同一个 v 距离相同，留最前的)
+        const int32_t v = s_cid[w][i];
+        for (int o = 0; o < i; ++o) if (s_cid[w][o] == v) { s_cd[w][i] = INFINITY; break; }
+    }
+    __syncwarp();
+    // 窗口内并集按 (距离, 原表在前, 下标) 取前 m_in 个，依次写到 orow[0..m_in)
+    int ins = 0;
+    const int tot = M + np;
+    for (int e = lane; e < tot; e += 32) {
+        const bool orig = e < M;
+        const float d = orig ? s_od[w][e] : s_cd[w][e - M];
+        if (!(d < INFINITY)) continue;
+        const int32_t id = orig ? s_oid[w][e] : s_cid[w][e - M];
+        int rank = 0;
+        for (int o = 0; o < tot; ++o) {
+            const float od = o < M ? s_od[w][o] : s_cd[w][o - M];
+            rank += (od < d) || (od == d && o < e);
+        }
+        if (rank < m_in) { orow[rank] = id; if (!orig) ++ins; }
+    }
+    // 窗口外的原候选按原顺序接在后面
+    if (lane == 0) {
+        int pos = m_in;
+        for (int k = 0; k < M; ++k) if (!(s_od[w][k] < INFINITY)) orow[pos++] = s_oid[w][k];
+    }
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) ins += __shfl_xor_sync(0xffffffffu, ins, off);
+    if (lane == 0) {
+        atomicAdd(&ctr->points, 1ull); atomicAdd(&ctr->cand, static_cast<unsigned long long>(nc));
+        atomicAdd(&ctr->pass, static_cast<unsigned long long>(np)); atomicAdd(&ctr->inserted, static_cast<unsigned long long>(ins));
+    }
+}
